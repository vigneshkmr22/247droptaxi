# Copy to .env.local for local work. On Vercel set the same names in Project Settings > Environment Variables.

# Postgres connection string (Neon via the Vercel Marketplace sets DATABASE_URL for you).
# Leave empty locally to use the built-in PGlite database in .data/.
DATABASE_URL=

# Shared secret for /admin (use a long random value).
ADMIN_TOKEN=

# Public address of the site, used in canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Maps key (Places API New + Routes API) for place search and road distances.
GOOGLE_MAPS_API_KEY=

# Uploads from /admin go to Vercel Blob when this is set (create a Blob store in the Vercel dashboard).
BLOB_READ_WRITE_TOKEN=

# Shown in the footer and on the contact page.
NEXT_PUBLIC_SUPPORT_EMAIL=support@droptaxi.com
NEXT_PUBLIC_BUSINESS_ADDRESS=Your business address, City, State

# Booking alert emails through Resend (resend.com). Both are needed to switch it on.
RESEND_API_KEY=
BOOKING_ALERT_EMAIL=

# Office address for booking emails (comma separated for several); defaults to 247droptaxii@gmail.com.
# Customers get a confirmation email too, which needs a verified Resend domain in BOOKING_ALERT_FROM, e.g. "247 Drop Taxi <bookings@247droptaxi.com>".
BOOKING_ALERT_FROM=

# WhatsApp booking messages via the Meta WhatsApp Cloud API. All three are needed to switch it on.
# The template body must use 13 variables {{1}}..{{13}}: booking id, name, phone, email, pickup, drop, vehicle, journey type,
# travel date & time, distance, duration, extra per km, total. OFFICE_WHATSAPP defaults to 7200345635.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en
OFFICE_WHATSAPP=
